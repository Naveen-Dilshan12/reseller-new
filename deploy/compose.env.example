# Non-secret values for Compose interpolation. Copy to deploy/compose.env (git-ignored) and fill in.
# Names and placeholders only. Do not put passwords, keys or tokens in this file.

# Release tag for the three images (backend, web, tools). Use an immutable tag, never "latest".
APP_VERSION=REPLACE_WITH_RELEASE_TAG

# Final PUBLIC API URL including the /api/v1 prefix, e.g. https://<final-host>/api/v1  (OPEN DECISION: same host vs. separate API host).
# Baked into the web bundle and its Content-Security-Policy; changing it requires rebuilding the web image.
NEXT_PUBLIC_API_URL=REPLACE_WITH_FINAL_PUBLIC_API_URL

# Database names (the password is the secret FILE deploy/secrets/db_password, not a variable).
DB_NAME=hexalyte_reseller
DB_USER=hexalyte_app

# Where backend / web are published ON THE HOST. Keep them on loopback unless the reverse proxy runs elsewhere.
# The defaults below are placeholders: confirm they are free on the VPS first.
BACKEND_BIND=127.0.0.1:14100
WEB_BIND=127.0.0.1:13000

# Resource limits: size these from the VPS inspection (total RAM, what the other applications use).
DB_MEM_LIMIT=1g
DB_CPUS=1.0
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=50
BACKEND_MEM_LIMIT=512m
BACKEND_CPUS=1.0
WEB_MEM_LIMIT=512m
WEB_CPUS=1.0

# Optional: pin the database image, ideally by digest, e.g. postgres:16-alpine@sha256:...
# POSTGRES_IMAGE=
