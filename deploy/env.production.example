# Backend runtime configuration. Copy to deploy/env.production ON THE SERVER ONLY (git-ignored, chmod 600).
# Variable NAMES and safe placeholders only. Fill real values on the server; never paste them into chat or commit them.
# Do NOT set DATABASE_URL here: backend-entrypoint.sh builds it from the db_password secret file.
# Do NOT set NODE_ENV, PORT, UPLOAD_DIR here: docker-compose.prod.yml sets them.

# ---- Required (the backend exits at startup without them; see apps/backend/src/config/env.ts) ----
# Random, at least 32 characters, not starting with "change-me":   openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_HEX
# Exactly 64 hex characters, not all zeros. BACK THIS UP SEPARATELY: losing it makes stored bank details, uploaded bank slips
# and the SMS gateway credentials permanently unreadable.   openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX

# ---- Public URLs (open decisions: the final hostnames) ----
# Exact browser origin of the web app, no trailing slash. Comma-separated if there is more than one.
CORS_ORIGINS=REPLACE_WITH_WEB_ORIGIN
# Base URL used in password-reset links (must be the web app's public URL).
FRONTEND_URL=REPLACE_WITH_WEB_ORIGIN
# 'true' only when every request reaches the backend with a trustworthy X-Forwarded-Proto (see docs/DEPLOYMENT.md, section 4).
FORCE_HTTPS=true
# Public hostnames the HTTP-to-HTTPS redirect may target (comma-separated, hostnames only: no scheme, port or path).
# Empty = never redirect; plain-HTTP requests get a 400. Requests the proxy marks as HTTPS (and the container health check) are unaffected.
ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_HOSTNAMES

# ---- Auth tuning (defaults shown; change only deliberately) ----
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---- Email (needed for password reset and the email-code fallback). Without SMTP_HOST the app only LOGS emails. ----
EMAIL_FROM=REPLACE_WITH_SENDER_ADDRESS
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# ---- Uploads and business settings ----
# Bank-slip limit. The CDN and the proxy must allow at least 6 MB request bodies for this default.
MAX_UPLOAD_MB=5
COMPANY_BANK_DETAILS=
COMMISSION_HOLD_DAYS=7
BUSINESS_TIMEZONE=Asia/Colombo
INTEGRATION_TIMEOUT_MS=15000
WEBHOOK_TOLERANCE_SECONDS=300

# ---- Database pool (Postgres max_connections must exceed this plus the one-shot jobs) ----
DATABASE_POOL_MAX=10

# ---- Proxy hop count (0-5). Unset = 1. Set ONLY after the real proxy chain is confirmed; a wrong value breaks per-client rate limiting or lets clients spoof IPs. ----
# TRUST_PROXY_HOPS=REPLACE_AFTER_PROXY_CHAIN_IS_CONFIRMED

# ---- Must stay UNSET/false in production ----
# OTP_DEBUG_MODE=false

# ---- NOT configured here ----
# SMSlenz credentials: entered in the admin UI (Admin > Settings > SMS Gateway); stored encrypted in the database.
