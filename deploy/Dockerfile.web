# syntax=docker/dockerfile:1
# Web image. Build context = repository root:
#   docker build -f deploy/Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=<final public API URL incl. /api/v1> -t hexalyte/reseller-web:<tag> .
# Built and validated on Node 24 in scratch rehearsals (see docs/PRODUCTION_READINESS.md); not yet built from a tagged release revision.
#
# NEXT_PUBLIC_API_URL is compiled into the browser bundle AND into the Content-Security-Policy `connect-src`
# (apps/web/next.config.mjs). It must be the FINAL public API URL; changing it later means rebuilding this image.
# There is intentionally no default: the API hostname/path is still an open decision.

FROM node:24-alpine AS build
ARG NEXT_PUBLIC_API_URL
RUN test -n "$NEXT_PUBLIC_API_URL" || (echo "ERROR: --build-arg NEXT_PUBLIC_API_URL is required (no default on purpose)" >&2; exit 1)
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/web apps/web
WORKDIR /app/apps/web
RUN npm run build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --omit=dev --workspace apps/web
COPY --from=build /app/apps/web/.next /app/apps/web/.next
COPY --from=build /app/apps/web/public /app/apps/web/public
COPY --from=build /app/apps/web/next.config.mjs /app/apps/web/next.config.mjs
RUN chown -R node:node /app/apps/web/.next
WORKDIR /app/apps/web
USER node
EXPOSE 3000
CMD ["/app/node_modules/.bin/next", "start", "-p", "3000", "-H", "0.0.0.0"]
