# syntax=docker/dockerfile:1
# Backend image. Build context = repository root (the workspace lockfile lives there):
#   docker build -f deploy/Dockerfile.backend --target runtime -t hexalyte/reseller-backend:<tag> .
#   docker build -f deploy/Dockerfile.backend --target tools   -t hexalyte/reseller-tools:<tag> .
# Built and validated on Node 24 in scratch rehearsals (see docs/PRODUCTION_READINESS.md); not yet built from a tagged release revision.
# Differences from apps/backend/Dockerfile: reproducible `npm ci` from the lockfile, no migration in the start command,
# a separate one-shot "tools" image for migrations / first-admin creation, and a health check (defined in docker-compose.prod.yml).

FROM node:24-alpine AS base
# Prisma's query engine needs OpenSSL on Alpine.
RUN apk add --no-cache openssl
WORKDIR /app

# ---- build: full dependencies, generated Prisma client, compiled JS --------------------------------------------------
FROM base AS build
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/backend/tsconfig.json apps/backend/tsconfig.json
COPY apps/backend/prisma apps/backend/prisma
# Only what the build and the one-shot tools need; diagnostic / QA scripts must never enter an image.
COPY apps/backend/scripts/check-deploy-config.cjs apps/backend/scripts/check-deploy-config.cjs
COPY apps/backend/scripts/create-first-admin.ts apps/backend/scripts/create-first-admin.ts
COPY apps/backend/src apps/backend/src
WORKDIR /app/apps/backend
# Needs no database and no .env (none is in the context).
RUN npx prisma generate
# First step of `npm run build` is scripts/check-deploy-config.cjs: it FAILS the image build while the verification
# cutoff is still the placeholder or invalid.
RUN npm run build

# ---- tools: one-shot jobs (prisma migrate deploy, create-first-admin). Never started as a service. ---------------------
FROM build AS tools
COPY deploy/backend-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh && chown -R node:node /app
USER node
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["npx", "prisma", "migrate", "status"]

# ---- runtime: production dependencies only, no migration on start --------------------------------------
FROM base AS runtime
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --omit=dev --workspace apps/backend
# NOTE: the Prisma CLI is still present in node_modules (the lockfile pulls `prisma` in through @prisma/client; verified that
# --omit=dev and --omit=peer do not remove it). Nothing runs it at startup; migrations run only from the separate "tools" image.
# The generated client (including the query engine) lives in the hoisted node_modules/.prisma.
COPY --from=build /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=build /app/apps/backend/dist /app/apps/backend/dist
COPY deploy/backend-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh && mkdir -p /app/uploads && chown -R node:node /app/uploads
WORKDIR /app/apps/backend
USER node
EXPOSE 4100
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/server.js"]
