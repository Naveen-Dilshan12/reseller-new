NODE_ENV=development
PORT=4100
API_PREFIX=api/v1

# Force HTTPS (set to 'true' in production behind reverse proxy)
FORCE_HTTPS=false

# Public hostnames the FORCE_HTTPS redirect may send browsers to (comma-separated, hostnames only: no scheme, port or path).
# Empty = never redirect (plain-HTTP requests get a 400). Requests the proxy marks as HTTPS are not affected.
# ALLOWED_HOSTS=partner.example.com

# Number of reverse proxies/CDNs in front of the backend (default 1). Set only after the real chain is confirmed.
# TRUST_PROXY_HOPS=1

# PostgreSQL (docker-compose exposes 5433 locally). Use your own local credentials.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5433/hexalyte_reseller

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth: at least 32 random characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_HEX
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# AES-256-GCM key for SaaS API credentials: 32 bytes as 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX

# Bank slip uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Commission: days after payment verification before approved commission becomes payable
COMMISSION_HOLD_DAYS=7
BUSINESS_TIMEZONE=Asia/Colombo

# SaaS integration
INTEGRATION_TIMEOUT_MS=15000
WEBHOOK_TOLERANCE_SECONDS=300

# Development admin created by `npm run db:seed` (prisma/seed.ts reads these three). Local use only.
# Password: at least 10 characters, choose your own; there is deliberately no default.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Admin

# Optional approved reseller login created by `npm run db:seed` (leave email and password blank to skip)
SEED_RESELLER_EMAIL=
SEED_RESELLER_PASSWORD=
SEED_RESELLER_NAME=Example Partner

# Shown to resellers on the activation request form, e.g. "Example (Pvt) Ltd | Example Bank, Colombo 03 | 0000000000"
COMPANY_BANK_DETAILS=

# Email / SMTP configuration (leave SMTP_HOST empty to only log emails)
EMAIL_FROM="Example Company <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
